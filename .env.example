# Copy this file to `.env` and fill in real values.
# .env is gitignored — never commit real secrets.

# Get from @BotFather on Telegram
MEDISENSE_TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID (message @userinfobot to find it)
MEDISENSE_TELEGRAM_CHAT_ID=

# Relative's phone number for SMS fallback via Termux, e.g. +919876543210
MEDISENSE_RELATIVE_PHONE=

# Frame source: webcam index (0), a video file path, or a stream URL.
# Video files replay against a video clock so second-based thresholds behave
# the same as on a live camera — see docs/VALIDATION.md.
#   MEDISENSE_CAM_SOURCE=0
#   MEDISENSE_CAM_SOURCE=clips/night_roll.mp4
#   MEDISENSE_CAM_SOURCE=rtsp://cam.ward2/stream
MEDISENSE_CAM_SOURCE=0

# Restart a video file when it ends (file sources only). 1=true
MEDISENSE_LOOP_VIDEO=0

# Run without GUI window (server / SSH). 1=true
MEDISENSE_HEADLESS=0

# Pose backend: auto (YOLO then MediaPipe) | yolo | mediapipe
MEDISENSE_POSE_BACKEND=auto

# Ultralytics YOLO-pose weights. Downloaded into the working directory on
# first run unless a copy already exists at src/medisense/models/.
MEDISENSE_YOLO_MODEL=yolov8n-pose.pt

# Expression channel quality gates. A classifier returns a confident-looking
# label for any image, so crops that are not clearly a readable face are
# rejected instead of scored. Raise these if the panel reports expressions you
# do not trust; lower them if it reads NOT ASSESSED too often.
#   minimum top-1 model confidence before a label is shown at all
MEDISENSE_EMOTION_MIN_CONFIDENCE=0.45
#   minimum face crop size in pixels
MEDISENSE_EMOTION_MIN_FACE_PX=64
#   minimum focus (variance of Laplacian); rejects motion blur
MEDISENSE_EMOTION_MIN_SHARPNESS=8.0
#   seconds without a readable face before the panel reports NOT ASSESSED
MEDISENSE_PAIN_STALE_SEC=10.0

# Optional: enables LLM-written shift handover reports via `medisense-report`.
# Without it the report falls back to local structured synthesis.
GEMINI_API_KEY=
