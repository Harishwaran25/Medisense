# Copy this file to `.env` and fill in real values.
# .env is gitignored — never commit real secrets.

# Get from @BotFather on Telegram
MEDISENSE_TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID (message @userinfobot to find it)
MEDISENSE_TELEGRAM_CHAT_ID=

# Relative's phone number for SMS fallback via Termux, e.g. +919876543210
MEDISENSE_RELATIVE_PHONE=

# Camera index (0 = default webcam)
MEDISENSE_CAM_SOURCE=0

# Run without GUI window (server / SSH). 1=true
MEDISENSE_HEADLESS=0

# Pose backend: auto (YOLO then MediaPipe) | yolo | mediapipe
MEDISENSE_POSE_BACKEND=auto

# Ultralytics YOLO-pose weights (downloaded on first run)
MEDISENSE_YOLO_MODEL=yolov8n-pose.pt
